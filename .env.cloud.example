# Cloud / serverless configuration for Cinderwake Scribe.
# In AWS Amplify these go in the app's Environment variables (NOT committed).
# For a local test of the S3 backend, copy to ".env.local" and fill in.

# --- Storage backend -------------------------------------------------------
STORAGE=s3
S3_BUCKET=your-scribe-bucket-name
AWS_REGION=us-east-1

# AWS credentials for the S3 client. On Amplify you can instead grant the
# compute role S3 access and omit these (recommended). For a quick start or
# local test, an IAM user's keys work:
# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=...

# --- Anthropic co-writer ---------------------------------------------------
# In the cloud the key comes ONLY from here and is never written to S3.
ANTHROPIC_API_KEY=sk-ant-...
# Optional:
# SCRIBE_MODEL=claude-opus-4-8
# ANTHROPIC_WORKSPACE_ID=wrkspc_...

# --- Password gate (single shared login) -----------------------------------
# If SITE_PASSWORD is unset the app is OPEN. Always set it in the cloud.
SITE_USER=sridhar
SITE_PASSWORD=choose-a-strong-password
